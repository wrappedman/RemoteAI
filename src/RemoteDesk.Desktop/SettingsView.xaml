<UserControl x:Class="RemoteDesk.Desktop.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30" MaxWidth="900" HorizontalAlignment="Left">
  <TextBlock Text="Connection settings" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Policies apply to new sessions. Saving restarts the incoming listener and disconnects its current Host session, not your outgoing tabs." TextWrapping="Wrap" Foreground="#8FA2BB" Margin="0,8,0,20"/>
  <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="Network &amp; session defaults" FontSize="17" FontWeight="SemiBold"/>
   <WrapPanel Margin="0,15,0,10"><StackPanel Width="130" Margin="0,0,18,0"><TextBlock Text="TCP listening port" Style="{StaticResource Caption}"/><TextBox x:Name="PortSetting" MaxLength="5"/></StackPanel><StackPanel Width="120" Margin="0,0,18,0"><TextBlock Text="Default FPS" Style="{StaticResource Caption}"/><ComboBox x:Name="FpsSetting"><ComboBoxItem Content="5"/><ComboBoxItem Content="15"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/><ComboBoxItem Content="30"/></ComboBox></StackPanel><StackPanel Width="140"><TextBlock Text="Default width" Style="{StaticResource Caption}"/><ComboBox x:Name="WidthSetting"><ComboBoxItem Content="960"/><ComboBoxItem Content="1440"/><ComboBoxItem Content="1920"/></ComboBox></StackPanel></WrapPanel>
   <CheckBox x:Name="AvailableSetting" Content="Available for incoming requests when the visible app starts"/>
   <TextBlock Text="UDP discovery remains on 45832. Up to 8 outgoing tabs and 1 incoming Controller; no background Windows Service or Internet relay." TextWrapping="Wrap" Foreground="#8FA2BB" FontSize="11" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Host approval policy" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <CheckBox x:Name="ControlSetting" Content="Allow user to grant mouse &amp; keyboard control"/><CheckBox x:Name="FilesSetting" Content="Allow user to grant shared-folder / file-transfer access"/><CheckBox x:Name="EffectsSetting" Content="Allow user to grant temporary animation changes"/>
   <CheckBox x:Name="AdminSetting" Content="Permit requests to restart with UAC elevation (local confirmation required)"/><CheckBox x:Name="LockSetting" Content="Permit requests to block physical mouse AND keyboard for 30 seconds"/>
   <TextBlock Text="Input blocking needs fresh Host confirmation, may require elevation and is released by Ctrl+Alt+Del, expiry, disconnect or process exit. Secure Desktop and Ctrl+Alt+Del cannot be remotely injected." TextWrapping="Wrap" Foreground="#C4A2AB" FontSize="11" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Shared folder" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Approved Controllers browse/download this folder inside RemoteDesk and upload to its root. This is not an SMB share or a mapped drive. No symlinks, remote execution, overwrite or access outside the selected root." Foreground="#8FA2BB" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Choose…" Click="Folder_Click" Margin="10,0,0,0"/><TextBox x:Name="FolderSetting" MaxLength="1024"/></DockPanel>
   <Button Content="Open transfer cache (partial uploads)" Click="Cache_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock Text="Resume uses 32 KiB acknowledged chunks and final SHA-256. Max 8 GiB/file, 16 partial files / 16 GiB cache. Pause/reconnect and select the same file to resume; do not delete parts you want to keep." Foreground="#8FA2BB" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Password-assisted automatic approval" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Off by default. Only Controllers you explicitly trust in a previous local approval can use this. The Host app must remain open and visible. This is not an unattended service or a bypass for UAC." Foreground="#8FA2BB" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12"/>
   <TextBlock Text="New password (16+ characters; leave empty to keep existing)" Style="{StaticResource Caption}"/><PasswordBox x:Name="NewPassword" MaxLength="256" Padding="10" Background="#11151C" Foreground="White" BorderBrush="#354151"/>
   <CheckBox x:Name="PasswordSetting" Content="Enable password access for trusted Controller keys" Margin="0,12,0,6"/><CheckBox x:Name="PasswordControlSetting" Content="Grant input control to trusted password connections"/><CheckBox x:Name="PasswordFilesSetting" Content="Grant shared-folder access to trusted password connections"/>
   <TextBlock x:Name="TrustedCount" Foreground="#8FA2BB" FontSize="12" Margin="0,12,0,10"/><WrapPanel><Button Content="Forget all trusted Controllers" Click="Forget_Click"/><Button Content="Remove saved password" Click="RemovePassword_Click" Margin="10,0,0,0"/></WrapPanel>
  </StackPanel></Border>
  <Button x:Name="SaveSettingsButton" Content="Save settings &amp; restart incoming listener" Click="Save_Click" HorizontalAlignment="Left" Background="#327DDB" Margin="0,20,0,0"/>
  <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="#FFB1BE" Margin="0,12,0,20"/>
 </StackPanel></ScrollViewer>
</UserControl>
